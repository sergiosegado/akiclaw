# AkiClaw Agent Configuration
# Copy this to .env and fill in your values

# --- Required ---

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# LLM API Key (Anthropic, OpenRouter, MiniMax, or any OpenAI-compatible provider)
AKICLAW_API_KEY=your-api-key-here

# Comma-separated Telegram user IDs that can talk to the bot
# Get your ID from @userinfobot on Telegram
# IMPORTANT: If empty, the bot rejects ALL DMs for security
TELEGRAM_ALLOWED_USERS=your-telegram-user-id

# --- LLM Provider (uncomment one block) ---

# Anthropic Claude (direct):
AKICLAW_MODEL=claude-sonnet-4-20250514
OPENROUTER_ENDPOINT=https://api.anthropic.com/v1/messages

# MiniMax M2.7 (direct):
# AKICLAW_MODEL=MiniMax-M2.7
# OPENROUTER_ENDPOINT=https://api.minimax.io/v1/chat/completions

# OpenRouter (any model):
# AKICLAW_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# --- Optional ---

# Public DM commands (comma-separated, available to non-whitelisted users)
# PUBLIC_DM_COMMANDS=/credential,/join-agent

# Custom reject message for unauthorized DMs
# DM_REJECT_MESSAGE=I only respond to specific commands in DMs. Use /start to see available commands.

# Supabase for cloud conversation persistence
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-key
